---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>404 — Javier Sisques</title>
    <meta
      name="description"
      content="Página no encontrada. / Page not found."
    />
  </head>
  <body class="min-h-screen">
    <main
      class="mx-auto flex min-h-screen max-w-md flex-col items-center justify-center px-6 text-center"
    >
      <p class="font-mono text-sm font-semibold text-[var(--accent)]">404</p>
      <h1 class="mt-2 font-mono text-2xl font-bold text-[var(--text-primary)]">
        Página no encontrada / Page not found
      </h1>
      <div class="mt-6 flex gap-4 font-mono text-sm">
        <a
          href="/es/"
          class="text-[var(--accent)] underline decoration-[var(--accent-border)] underline-offset-2 hover:text-[var(--accent-hover)]"
        >
          Volver al inicio (ES)
        </a>
        <a
          href="/en/"
          class="text-[var(--accent)] underline decoration-[var(--accent-border)] underline-offset-2 hover:text-[var(--accent-hover)]"
        >
          Back to home (EN)
        </a>
      </div>
    </main>
  </body>
</html>
