---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Javier Sisques" description="Página no encontrada.">
  <div class="py-20 text-center">
    <p class="text-sm font-semibold text-sky-600 dark:text-sky-400">404</p>
    <h1 class="mt-2 text-2xl font-bold text-slate-900 dark:text-slate-100">
      Página no encontrada
    </h1>
    <a
      href="/"
      class="mt-6 inline-block text-sky-600 underline hover:text-sky-500 dark:text-sky-400"
    >
      Volver al inicio
    </a>
  </div>
</BaseLayout>
