---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import SubscribeCta from '../../../components/SubscribeCta.astro';
import { languages } from '../../../i18n/ui';
import {
  useTranslations,
  splitLocalizedId,
  type Lang,
} from '../../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return Object.keys(languages).flatMap((lang) => {
    const localizedPosts = posts.filter(
      (post) => splitLocalizedId(post.id).lang === lang,
    );
    const tags = [...new Set(localizedPosts.flatMap((post) => post.data.tags))];

    return tags.map((tag) => ({
      params: { lang, tag },
      props: {
        tag,
        posts: localizedPosts
          .filter((post) => post.data.tags.includes(tag))
          .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
      },
    }));
  });
}

const lang = Astro.params.lang as Lang;
const { tag, posts } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={`#${tag} — Javier Sisques`}
  description={`${t('tag.postsTaggedWith')} #${tag}.`}
  otherLangPath={`/tags/${tag}/`}
>
  <p class="font-mono text-xs tracking-[var(--ls-caps)] text-[var(--accent)]">
    {t('home.eyebrow')}
  </p>
  <h1
    class="mt-3 font-mono text-[length:var(--text-h1)] leading-[var(--lh-tight)] text-[var(--text-primary)]"
  >
    #{tag}
  </h1>
  <a
    href={`/${lang}/tags/`}
    class="mt-4 inline-block font-mono text-[0.8125rem] text-[var(--text-muted)] hover:text-[var(--accent)]"
  >
    {t('post.back')}
  </a>
  <div class="mt-6">
    {posts.map((post) => <PostCard lang={lang} post={post} />)}
  </div>
  <SubscribeCta lang={lang} />
</BaseLayout>
