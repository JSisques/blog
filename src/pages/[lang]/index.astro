---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SubscribeCta from '../../components/SubscribeCta.astro';
import { languages } from '../../i18n/ui';
import { useTranslations, splitLocalizedId, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const posts = (
  await getCollection(
    'blog',
    ({ id, data }) => splitLocalizedId(id).lang === lang && !data.draft,
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout
  lang={lang}
  title={t('site.title')}
  description={t('site.description')}
  otherLangPath="/"
>
  <div class="bg-dot-grid px-0 pt-2 pb-6">
    <p class="font-mono text-xs tracking-[var(--ls-caps)] text-[var(--accent)]">
      {t('home.eyebrow')}
    </p>
    <h1
      class="mt-3 font-mono text-[length:var(--text-h1)] leading-[var(--lh-tight)] text-[var(--text-primary)]"
    >
      {t('home.title')}
    </h1>
    <p
      class="mt-4 max-w-[520px] text-[length:var(--text-body-lg)] leading-[var(--lh-body)] text-[var(--text-secondary)]"
    >
      {t('home.subtitle')}
    </p>
  </div>

  {
    tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-1 rounded-full border border-[var(--accent-border)] bg-[var(--accent-muted)] px-2.5 py-1 font-mono text-[0.6875rem] font-semibold tracking-[var(--ls-caps)] text-[var(--accent-hover)]">
          {t('home.allTag')}
        </span>
        {tags.map((tag) => (
          <a
            href={`/${lang}/tags/${tag}/`}
            class="inline-flex items-center gap-1 rounded-full border border-[var(--border-default)] bg-[var(--bg-surface-raised)] px-2.5 py-1 font-mono text-[0.6875rem] font-semibold tracking-[var(--ls-caps)] text-[var(--text-secondary)] hover:border-[var(--accent-border)] hover:text-[var(--accent)]"
          >
            {tag}
          </a>
        ))}
      </div>
    )
  }

  <div class="mt-4">
    {
      posts.length > 0 ? (
        posts.map((post) => <PostCard lang={lang} post={post} />)
      ) : (
        <p class="text-[var(--text-muted)]">{t('home.empty')}</p>
      )
    }
  </div>

  <SubscribeCta lang={lang} />
</BaseLayout>
