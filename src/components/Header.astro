---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Path in the other language to link to from the switcher, e.g. "/blog/my-post/". */
  otherLangPath: string;
}

const { lang, otherLangPath } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: `/${lang}/`, label: t('nav.home') },
  { href: `/${lang}/tags/`, label: t('nav.tags') },
  { href: `/${lang}/rss.xml`, label: t('nav.rss') },
];
---

<header class="border-b border-slate-200 dark:border-slate-800">
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-6"
  >
    <a
      href={`/${lang}/`}
      class="text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100"
    >
      Javier Sisques
    </a>
    <div class="flex items-center gap-5">
      <nav
        class="flex gap-5 text-sm font-medium text-slate-600 dark:text-slate-400"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class="hover:text-sky-600 dark:hover:text-sky-400"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <LanguageSwitcher lang={lang} path={otherLangPath} />
    </div>
  </div>
</header>
