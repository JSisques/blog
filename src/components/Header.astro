---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Path in the other language to link to from the switcher, e.g. "/blog/my-post/". */
  otherLangPath: string;
}

const { lang, otherLangPath } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: `/${lang}/`, label: t('nav.home') },
  { href: `/${lang}/tags/`, label: t('nav.tags') },
  { href: `/${lang}/rss.xml`, label: t('nav.rss') },
];
---

<header
  class="sticky top-0 z-20 border-b border-[var(--border-subtle)] bg-[var(--bg-canvas)]"
>
  <div
    class="mx-auto flex max-w-[var(--container-max)] items-center justify-between gap-4 px-6 py-[18px]"
  >
    <a
      href={`/${lang}/`}
      class="flex items-baseline gap-1.5 font-mono text-lg font-bold text-[var(--text-primary)]"
    >
      <span class="text-[var(--text-primary)]"
        >j<span class="text-[var(--accent)]">sisques</span></span
      ><span class="text-xs font-medium text-[var(--text-muted)]">/blog</span>
    </a>
    <div class="flex items-center gap-6">
      <nav class="hidden gap-6 font-mono text-[0.8125rem] sm:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-[var(--text-secondary)] hover:text-[var(--accent)]"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <LanguageSwitcher lang={lang} path={otherLangPath} />
      <button
        type="button"
        data-subscribe-open
        class="rounded-[var(--radius-sm)] border border-[var(--border-default)] bg-[var(--bg-surface-raised)] px-3 py-1.5 font-mono text-sm font-semibold text-[var(--text-primary)] transition-colors duration-[var(--dur-fast)] hover:bg-[var(--bg-surface)]"
      >
        {t('nav.subscribe')}
      </button>
    </div>
  </div>
</header>
