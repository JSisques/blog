---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/tags/', label: 'Tags' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<header class="border-b border-slate-200 dark:border-slate-800">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-6">
    <a
      href="/"
      class="text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100"
    >
      Javier Sisques
    </a>
    <nav
      class="flex gap-5 text-sm font-medium text-slate-600 dark:text-slate-400"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="hover:text-sky-600 dark:hover:text-sky-400"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
