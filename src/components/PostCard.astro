---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';
import { splitLocalizedId, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  post: CollectionEntry<'blog'>;
}

const { lang, post } = Astro.props;
const { slug } = splitLocalizedId(post.id);
---

<article class="border-b border-[var(--border-subtle)] py-6 last:border-none">
  <a href={`/${lang}/blog/${slug}/`} class="group block">
    <div class="mb-1.5 font-mono text-xs text-[var(--text-muted)]">
      <time datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date, lang)}
      </time>
    </div>
    <h2
      class="mb-1.5 text-[1.1875rem] font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent)]"
    >
      {post.data.title}
    </h2>
    <p
      class="text-[0.9375rem] leading-[var(--lh-body)] text-[var(--text-secondary)]"
    >
      {post.data.description}
    </p>
  </a>
  <div class="mt-2.5 flex flex-wrap gap-3">
    {
      post.data.tags.map((tag) => (
        <a
          href={`/${lang}/tags/${tag}/`}
          class="font-mono text-[0.6875rem] text-[var(--text-muted)] hover:text-[var(--accent)]"
        >
          #{tag}
        </a>
      ))
    }
  </div>
</article>
