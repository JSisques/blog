---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';
import { splitLocalizedId, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  post: CollectionEntry<'blog'>;
}

const { lang, post } = Astro.props;
const { slug } = splitLocalizedId(post.id);
---

<article
  class="border-b border-slate-200 py-6 last:border-none dark:border-slate-800"
>
  <a href={`/${lang}/blog/${slug}/`} class="group block">
    <h2
      class="text-xl font-semibold text-slate-900 group-hover:text-sky-600 dark:text-slate-100 dark:group-hover:text-sky-400"
    >
      {post.data.title}
    </h2>
    <p class="mt-2 text-slate-600 dark:text-slate-400">
      {post.data.description}
    </p>
  </a>
  <div
    class="mt-3 flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-500"
  >
    <time datetime={post.data.date.toISOString()}
      >{formatDate(post.data.date, lang)}</time
    >
    {
      post.data.tags.map((tag) => (
        <a
          href={`/${lang}/tags/${tag}/`}
          class="rounded-full bg-slate-100 px-2 py-0.5 hover:bg-sky-100 hover:text-sky-700 dark:bg-slate-800 dark:hover:bg-sky-950 dark:hover:text-sky-400"
        >
          #{tag}
        </a>
      ))
    }
  </div>
</article>
