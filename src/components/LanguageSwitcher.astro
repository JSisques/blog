---
import { languages } from '../i18n/ui';
import { otherLang, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Path in the *other* language to link to, without its /<lang> prefix, e.g. "/blog/my-post/". */
  path: string;
}

const { lang, path } = Astro.props;
const target = otherLang(lang);
const t = useTranslations(lang);
---

<a
  href={`/${target}${path}`}
  class="rounded-full border border-[var(--border-default)] px-3 py-1 font-mono text-xs font-medium text-[var(--text-secondary)] transition-colors duration-[var(--dur-fast)] hover:border-[var(--accent-border)] hover:text-[var(--accent)]"
  hreflang={target}
>
  {t('lang.switchTo')}
  <span class="sr-only">({languages[target]})</span>
</a>
