---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--border-subtle)] pt-6"
>
  <p class="m-0 text-[0.9375rem] text-[var(--text-secondary)]">
    {t('cta.text')}
  </p>
  <button
    type="button"
    data-subscribe-open
    class="shrink-0 rounded-[var(--radius-sm)] border border-[var(--border-default)] bg-[var(--bg-surface-raised)] px-4 py-2 font-mono text-sm font-semibold text-[var(--text-primary)] transition-colors duration-[var(--dur-fast)] hover:bg-[var(--bg-surface)]"
  >
    {t('nav.subscribe')}
  </button>
</div>
