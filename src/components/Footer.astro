---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-subtle)] px-6 py-7">
  <div
    class="mx-auto flex max-w-[var(--container-max)] flex-col items-center gap-2 font-mono text-xs text-[var(--text-muted)] sm:flex-row sm:justify-between"
  >
    <p class="m-0">&copy; {year} jsisques</p>
    <a
      href="https://github.com/JSisques/blog"
      class="hover:text-[var(--accent)]"
    >
      {t('footer.source')}
    </a>
  </div>
</footer>
