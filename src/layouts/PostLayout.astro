---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<BaseLayout
  title={`${post.data.title} — Javier Sisques`}
  description={post.data.description}
>
  <article>
    <header class="mb-8">
      <h1
        class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100"
      >
        {post.data.title}
      </h1>
      <div
        class="mt-3 flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-500"
      >
        <time datetime={post.data.date.toISOString()}
          >{formatDate(post.data.date)}</time
        >
        {
          post.data.tags.map((tag) => (
            <a
              href={`/tags/${tag}/`}
              class="rounded-full bg-slate-100 px-2 py-0.5 hover:bg-sky-100 hover:text-sky-700 dark:bg-slate-800 dark:hover:bg-sky-950 dark:hover:text-sky-400"
            >
              #{tag}
            </a>
          ))
        }
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
