{
  "name": "jsisques/blog",
  "version": "0.1.0",
  "description": "Javier Sisques' personal blog — notes on software development, homelab, and DevOps.",
  "author": "Javier Sisques",
  "repository": {
    "type": "git",
    "url": "https://github.com/JSisques/blog.git"
  },
  "homepage": "https://blog.jsisques.net",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,md}\"",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:changed": "vitest run --changed HEAD~1",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prepare": "node -e \"if(process.env.HUSKY!=='0')require('child_process').execSync('husky',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
